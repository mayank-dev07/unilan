# --- Server ---
PORT=8080
GIN_MODE=release         # use 'debug' locally
LOG_JSON=true            # structured JSON logs for prod

# --- Database (Postgres-compatible: Postgres, CockroachDB, Neon, Supabase) ---
# Use sslmode=require everywhere — works locally AND on PaaS hosts (Render,
# Fly, Railway) which don't have CockroachDB's CA bundled. It still encrypts
# the connection; it just skips cert-chain validation.
#
# CockroachDB Serverless:
#   DATABASE_URL=postgresql://user:pwd@cluster-xxx.cockroachlabs.cloud:26257/defaultdb?sslmode=require
# Neon:
#   DATABASE_URL=postgresql://user:pwd@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-random-32-byte-hex
JWT_TTL_HOURS=72

# Google OAuth client ID (Web application type, from console.cloud.google.com)
GOOGLE_CLIENT_ID=

# --- Message encryption (AES-256-GCM) ---
# Must be exactly 32 bytes hex-encoded (64 hex chars)
# Generate with: openssl rand -hex 32
MESSAGE_ENC_KEY=replace-me-with-64-hex-chars

# --- LLM providers (chain: OpenRouter -> Groq) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Orchestrator tuning ---
TRANSLATION_CACHE_SIZE=4096
BREAKER_THRESHOLD=3            # consecutive failures before opening
BREAKER_COOLDOWN_SEC=60        # how long the breaker stays open

# --- Rate limiting (per user) ---
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20

# --- Cloudinary (avatar upload) ---
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# From Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_URL=

# --- Hasura (frontend uses this; backend doesn't call it directly) ---
HASURA_ENDPOINT=https://your-project.hasura.app
HASURA_ADMIN_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
